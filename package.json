{
  "name": "kanoodle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "cli": "node --import tsx scripts/cli.ts",
    "lint": "tsc --noEmit",
    "generate:auto": "node --import tsx scripts/generate-automatic.ts --full",
    "generate:silhouettes": "node --import tsx scripts/generate-silhouettes.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4"
  }
}
